{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineto.local/schemas/voice.schema.json",
  "title": "Kineto Locked Voice",
  "description": "A character's locked voice: the selected audition's provider, model and voice settings, its audio as a sample by artifact ID and content hash, and what it was made from (the character's bible entry and locked cast), so its staleness can be computed. Lines are spoken with it.",
  "type": "object",
  "required": ["schema_version", "character_id", "artifact_id", "provider", "model", "voice", "voice_name", "content_hash", "media_path", "dependencies"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "character_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 112},
    "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "voice": {
      "type": "object",
      "required": ["voice_id", "language", "speed_permille", "pitch_semitones"],
      "properties": {
        "voice_id": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2, "maxLength": 3},
        "emotion": {"enum": ["happy", "sad", "angry", "fearful", "disgusted", "surprised", "calm", "fluent", "whisper"]},
        "speed_permille": {"type": "integer", "minimum": 1, "maximum": 65535},
        "pitch_semitones": {"type": "integer", "minimum": -128, "maximum": 127}
      },
      "additionalProperties": false
    },
    "voice_name": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "media_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "content_hash", "impact"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "impact": {"enum": ["semantic", "cosmetic"]},
          "field": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
