{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineto.local/schemas/revisions.schema.json",
  "title": "Kineto Document Revisions",
  "type": "object",
  "required": ["schema_version", "kind", "revisions"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["story_analysis", "screenplay", "bible", "shot_plan"]},
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision", "artifact_id", "path", "status", "origin", "content_hash", "dependencies"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"},
          "status": {"enum": ["candidate", "locked", "superseded"]},
          "origin": {"enum": ["generated", "edited"]},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "required": ["compiler_version", "compiled_prompt", "prompt_hash", "applied_constraints", "dropped_constraints"],
            "properties": {
              "compiler_version": {"type": "string", "minLength": 1},
              "compiled_prompt": {"type": "string", "minLength": 1},
              "prompt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "applied_constraints": {"type": "array", "items": {"type": "string"}},
              "dropped_constraints": {"type": "array"}
            },
            "additionalProperties": true
          },
          "based_on": {"type": "integer", "minimum": 1},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact_id", "content_hash", "impact"],
              "properties": {
                "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
                "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "impact": {"enum": ["semantic", "cosmetic"]},
                "field": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
