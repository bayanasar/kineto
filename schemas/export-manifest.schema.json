{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineto.local/schemas/export-manifest.schema.json",
  "title": "Kineto Export Manifest",
  "description": "The project-level manifest of a production package: the scenes in screenplay order, each shot's locked video, sidecar and first frame in shot order, what is missing from a partial export, the total runtime and the timeline. Enough for an editor to assemble the shots without opening Kineto.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "project",
    "recipe",
    "exported_at",
    "complete",
    "scenes",
    "missing",
    "total_runtime_seconds"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3
      ],
      "description": "2 adds each shot's spoken lines; 3 the timeline."
    },
    "kind": {
      "const": "kineto.export"
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "title"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "complete": {
      "type": "boolean",
      "description": "Every shot in play is in the package."
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "location",
          "time",
          "shots"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "type": [
              "string",
              "null"
            ]
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "shot_id",
                "order",
                "video",
                "sidecar",
                "first_frame",
                "duration_seconds"
              ],
              "properties": {
                "shot_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,128}$"
                },
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The shot's place among every shot in play, gaps and all."
                },
                "video": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "sidecar": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "first_frame": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "duration_seconds": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "lines": {
                  "type": "array",
                  "description": "The audio files of the locked lines the shot carries, in the order they are said.",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "shot_id",
          "order",
          "reason"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "shot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "total_runtime_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "timeline": {
      "description": "The package's timeline: the OpenTimelineIO file, the same timeline as a CMX 3600 edit decision list, its frame rate, and each line cut at the end of the shot that carries it.",
      "type": "object",
      "required": [
        "otio",
        "edl",
        "frame_rate",
        "trimmed_lines"
      ],
      "properties": {
        "otio": {
          "type": "string",
          "minLength": 1
        },
        "edl": {
          "type": "string",
          "minLength": 1
        },
        "frame_rate": {
          "type": "integer",
          "minimum": 1
        },
        "trimmed_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "shot_id",
              "line",
              "cut_ms"
            ],
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "cut_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
