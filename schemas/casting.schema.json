{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineto.local/schemas/casting.schema.json",
  "title": "Kineto Casting Record",
  "description": "Every image made while casting one character, as cast.<character>.NNNN in order. Portrait candidates (under candidates/) carry a status: candidate, selected (at most one) or rejected. References (under refs/) are made from a portrait, named as their identity reference, and carry no status. Nothing is deleted. The lock is character.json.",
  "type": "object",
  "required": ["schema_version", "character_id", "images"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "character_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 112},
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "content_hash", "input_hash", "provider", "model", "media_path", "provenance", "dependencies"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "kind": {
            "enum": [
              "portrait",
              "front",
              "profile_left",
              "profile_right",
              "full_body",
              "costume",
              "expression_smile",
              "expression_tense"
            ]
          },
          "status": {"enum": ["candidate", "selected", "rejected"]},
          "identity_reference": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "media_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"},
          "media_state": {"enum": ["present", "evicted"]},
          "look": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "provenance": {
            "type": "object",
            "required": ["compiler_version", "compiled_prompt", "prompt_hash", "applied_constraints", "dropped_constraints"],
            "properties": {
              "compiler_version": {"type": "string", "minLength": 1},
              "compiled_prompt": {"type": "string", "minLength": 1},
              "prompt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "applied_constraints": {"type": "array", "items": {"type": "string"}},
              "dropped_constraints": {"type": "array"}
            },
            "additionalProperties": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact_id", "content_hash", "impact"],
              "properties": {
                "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
                "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "impact": {"enum": ["semantic", "cosmetic"]},
                "field": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
