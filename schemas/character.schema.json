{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineto.local/schemas/character.schema.json",
  "title": "Kineto Locked Character",
  "description": "A cast character production follows: the canonical portrait and its reference pack by stable artifact IDs and content hashes, how the provider takes the identity reference, the forbidden changes the bible names, and what the portrait was made from (the character's bible entry and the locked style), from which staleness is computed.",
  "type": "object",
  "required": ["schema_version", "character_id", "name", "portrait", "references", "provider_reference", "forbidden_changes", "dependencies"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "character_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 112},
    "name": {"type": "string", "minLength": 1},
    "portrait": {
      "type": "object",
      "required": ["kind", "artifact_id", "content_hash", "media_path"],
      "properties": {
        "kind": {
          "enum": [
            "portrait",
            "front",
            "profile_left",
            "profile_right",
            "full_body",
            "costume",
            "expression_smile",
            "expression_tense"
          ]
        },
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "media_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"}
      },
      "additionalProperties": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "artifact_id", "content_hash", "media_path"],
        "properties": {
          "kind": {
            "enum": [
              "portrait",
              "front",
              "profile_left",
              "profile_right",
              "full_body",
              "costume",
              "expression_smile",
              "expression_tense"
            ]
          },
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "media_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"}
        },
        "additionalProperties": true
      }
    },
    "provider_reference": {
      "type": "object",
      "required": ["provider", "mechanism", "role", "artifact_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "role": {"enum": ["identity"]},
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}
      },
      "additionalProperties": true
    },
    "forbidden_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "content_hash", "impact"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "impact": {"enum": ["semantic", "cosmetic"]},
          "field": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
