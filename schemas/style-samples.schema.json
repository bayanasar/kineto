{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineto.local/schemas/style-samples.schema.json",
  "title": "Kineto Style Samples",
  "description": "Every sample image of a style direction the director asked for, with the preset and its directives verbatim, the director's note, the screenplay scene it shows, its image under style/samples/, its prompt provenance and dependencies. Artifact IDs are style_sNNNN in order; at most one sample is selected; nothing is deleted. The locked style is bible/style.json.",
  "type": "object",
  "required": ["schema_version", "samples"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "preset", "preset_version", "directives", "scene_id", "status", "content_hash", "input_hash", "provider", "model", "media_path", "provenance", "dependencies"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "preset": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
          "preset_version": {"type": "integer", "minimum": 1},
          "directives": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "refines": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "scene_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
          "status": {"enum": ["candidate", "selected", "rejected"]},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "media_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"},
          "provenance": {
            "type": "object",
            "required": ["compiler_version", "compiled_prompt", "prompt_hash", "applied_constraints", "dropped_constraints"],
            "properties": {
              "compiler_version": {"type": "string", "minLength": 1},
              "compiled_prompt": {"type": "string", "minLength": 1},
              "prompt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "applied_constraints": {"type": "array", "items": {"type": "string"}},
              "dropped_constraints": {"type": "array"}
            },
            "additionalProperties": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact_id", "content_hash", "impact"],
              "properties": {
                "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
                "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "impact": {"enum": ["semantic", "cosmetic"]},
                "field": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
